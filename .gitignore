# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local

# Rust / Tauri
target/
**/src-tauri/target/
**/src-tauri/gen/

# Environment & secrets — never commit these
.env
.env.*
!.env.example
*.pem
# Includes the updater signing key: anyone holding it can sign an update that
# every installed copy will accept and run.
*.key
*.key.pub

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code — local per-machine settings (shared config lives in settings.json)
.claude/settings.local.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test / coverage
coverage/
.nyc_output/

# Misc
.cache/
.temp/
*.tsbuildinfo
