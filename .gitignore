# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local
# The browser client, built by CI and installed onto a deployment by
# deploy/publish-release.sh. webapp/ is where it lands there; the directory is
# committed empty because compose bind-mounts it into Caddy.
dist-web/
webapp/*
!webapp/.gitignore
!webapp/index.html

# Rust / Tauri
target/
**/src-tauri/target/
**/src-tauri/gen/

# Environment & secrets — never commit these
.env
.env.*
!.env.example
*.pem
# Includes the updater signing key: anyone holding it can sign an update that
# every installed copy will accept and run.
*.key
*.key.pub

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code — local per-machine settings (shared config lives in settings.json)
.claude/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test / coverage
coverage/
.nyc_output/

# Misc
.cache/
.temp/
*.tsbuildinfo

# Published installers on a deployment, fetched rather than committed.
releases/
# Which version of the browser client this deployment has installed. Written by
# deploy/publish-release.sh, kept outside webapp/ because that is served.
.webapp-published
