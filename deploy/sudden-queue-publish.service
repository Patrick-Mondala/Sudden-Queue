# Puts a published release in front of players, without being asked.
#
#   sudo cp deploy/sudden-queue-publish.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sudden-queue-publish.timer
#
# Paired with sudden-queue-publish.timer, which is what actually runs it.
# Installed once; after that a tag is the whole release.
#
# Adjust WorkingDirectory if you did not follow deploy/README.md.

[Unit]
Description=Publish the latest Sudden Queue release to this deployment
Documentation=https://github.com/Patrick-Mondala/Sudden-Queue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/sudden-queue

# Root, because it writes into the directories Caddy serves and the compose
# stack owns those as root. The script fetches over https and writes what it
# publishes; it takes no input from anywhere but the repository's own releases.
ExecStart=/srv/sudden-queue/deploy/publish-release.sh

# A failed run is not an emergency and must not become one. The next timer
# tick tries again, and the failure modes it is most likely to hit -- GitHub
# briefly unreachable, a release still being uploaded -- resolve themselves.
# Nothing is changed on the way to failing, so retrying is free.
SuccessExitStatus=0

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Every directory the script publishes into has to be listed here, because
# ProtectSystem=strict makes everything else read-only -- including the rest of
# the checkout. Miss one and the run dies partway with EPERM, after the files
# it already wrote and before the manifest that makes them live, which is a
# deployment stuck on the previous version with the next one half-installed.
#
# The script checks it can write to both before it does anything, so a missing
# entry here says so in the journal rather than failing silently mid-publish.
ReadWritePaths=/srv/sudden-queue/releases
ReadWritePaths=/srv/sudden-queue/webapp
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sudden-queue-publish
