# Caddy in front of the Sudden Queue server.
#
# The hostname comes from SQ_HOSTNAME in .env, so there is nothing to edit
# here. Caddy obtains and renews the certificate itself.

{$SQ_HOSTNAME} {
	# The published client, served from this deployment rather than from a
	# release host somewhere else.
	#
	# That is not only tidier: the app refuses to open until it has been told
	# whether it is current, so whatever answers that question is something
	# every player needs reachable before they can play. Served from here, it
	# is up exactly when the rest of the deployment is, and one outage cannot
	# take down play on a server that is otherwise fine.
	#
	#   /download/latest.json                     what the updater fetches
	#   /download/Sudden.Queue_x.y.z_x64-setup.exe  what a person downloads
	handle_path /download/* {
		root * /srv/releases
		# The manifest is the one file here that changes meaning in place: a
		# cached copy is a player told they are current when they are not.
		header /latest.json Cache-Control "no-cache"
		# Public data by definition -- every installed client fetches it
		# unauthenticated. Readable cross-origin so a download page hosted
		# anywhere can say which version this deployment is serving.
		header /latest.json Access-Control-Allow-Origin "*"
		file_server
	}

	# The same client, built for a browser instead of a window.
	#
	# For the players who cannot install anything, do not know how, or will not
	# trust an unsigned binary from a stranger -- which is most of the people
	# this was hard to hand to. Same bundle, same API, same version floor.
	#
	# Which is the catch worth knowing about: this build sends the version it
	# was compiled as, so it has to be redeployed with every release or the
	# floor refuses the website itself. publish-release.sh installs it in the
	# same ordered step that moves latest.json, for exactly that reason.
	# Matched with the trailing slash, not as a bare prefix: /app* would also
	# claim /application and anything else that happens to start that way.
	# handle_path strips /app, so /app/assets/x.js is read as /assets/x.js and
	# /app/ as /, which is the index.
	redir /app /app/
	handle_path /app/* {
		root * /srv/webapp

		# index.html is to this app what latest.json is to the installer: the
		# one file here that changes meaning in place. It names which bundle to
		# load, so a cached copy points a returning player at the previous
		# release -- and unlike the desktop app, a tab cannot update itself out
		# of that. It would send the old version, be refused by the floor this
		# deployment just raised, and sit on a screen telling it to update with
		# no way to do so short of a hard refresh nobody knows to try.
		#
		# no-cache is revalidate-before-use, not "never store": the browser
		# still keeps it and still gets a 304 when nothing has changed.
		#
		# Two paths, because handle_path has already stripped /app by the time
		# these match: the page is requested as / and served as index.html from
		# disk, so matching only the filename would miss every ordinary visit
		# and catch only somebody who typed it out.
		@page path / /index.html
		header @page Cache-Control "no-cache"

		# The opposite for everything else, because their names carry a content
		# hash: a given URL's bytes can never change, so re-checking is pure
		# latency. immutable says exactly that, and stops a reload revalidating
		# every asset on the page.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"

		# .published records which release this bundle came from, for the
		# publish script. It lives with the bundle so it cannot outlive it, and
		# it is nobody else's business.
		file_server {
			hide .published
		}
	}

	# The download page, which is the only thing a player sees before they have
	# the app. Served from the checkout rather than built, so `git pull` ships
	# it and there is no third artifact to publish.
	handle / {
		root * /srv/site
		file_server
	}
	handle /icon.png {
		root * /srv/site
		file_server
	}

	# The server holds a WebSocket per signed-in player. Caddy proxies those
	# without special configuration; flush_interval -1 stops it buffering the
	# push events, which would otherwise arrive in batches.
	reverse_proxy server:3000 {
		flush_interval -1
	}

	encode zstd gzip

	header {
		# Neither the app nor the site is ever meant to be framed.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format console
	}
}

# Testing on a bare IP, before DNS exists? Let's Encrypt will not issue a
# certificate for an address, so set SQ_HOSTNAME to `:80` and Caddy will serve
# plain HTTP.
#
# That is fine for proving the stack is up and wrong for players: sign-in
# tokens would cross the network in the clear and the Discord callback would be
# an unencrypted URL. Get a hostname before anyone else uses it.
