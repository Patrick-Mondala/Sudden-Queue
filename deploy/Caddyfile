# Caddy in front of the Sudden Queue server.
#
# The hostname comes from SQ_HOSTNAME in .env, so there is nothing to edit
# here. Caddy obtains and renews the certificate itself.

{$SQ_HOSTNAME} {
	# The published client, served from this deployment rather than from a
	# release host somewhere else.
	#
	# That is not only tidier: the app refuses to open until it has been told
	# whether it is current, so whatever answers that question is something
	# every player needs reachable before they can play. Served from here, it
	# is up exactly when the rest of the deployment is, and one outage cannot
	# take down play on a server that is otherwise fine.
	#
	#   /download/latest.json                     what the updater fetches
	#   /download/Sudden.Queue_x.y.z_x64-setup.exe  what a person downloads
	handle_path /download/* {
		root * /srv/releases
		# The manifest is the one file here that changes meaning in place: a
		# cached copy is a player told they are current when they are not.
		header /latest.json Cache-Control "no-cache"
		file_server
	}

	# The server holds a WebSocket per signed-in player. Caddy proxies those
	# without special configuration; flush_interval -1 stops it buffering the
	# push events, which would otherwise arrive in batches.
	reverse_proxy server:3000 {
		flush_interval -1
	}

	encode zstd gzip

	header {
		# The API is called by the desktop app, never framed or embedded.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format console
	}
}

# Testing on a bare IP, before DNS exists? Let's Encrypt will not issue a
# certificate for an address, so set SQ_HOSTNAME to `:80` and Caddy will serve
# plain HTTP.
#
# That is fine for proving the stack is up and wrong for players: sign-in
# tokens would cross the network in the clear and the Discord callback would be
# an unencrypted URL. Get a hostname before anyone else uses it.
