{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sudden Queue",
  "version": "0.1.4",
  "identifier": "com.gentl.suddenqueue",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sudden Queue",
        "width": 1320,
        "height": 940,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://suddenqueue.com/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4OTJDQUUyMDE2RTMzMDgKUldRSU0yNEI0c3FTS0xXc3l5L2FOZm42V0tBeG0rZUxUdlhoM2lkcmN0YURFV1RkdmlvaEtYbmsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
