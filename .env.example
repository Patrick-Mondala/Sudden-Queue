# Copy to .env and fill in. .env is gitignored - never commit real secrets.

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Change if you point at a hosted instance.
DATABASE_URL=postgresql://suddenqueue:suddenqueue_dev@localhost:5432/suddenqueue

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Signs session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Discord OAuth ----------------------------------------------------------
# Create an application at https://discord.com/developers/applications
# Then OAuth2 -> Redirects -> add the callback URL below.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:3000/auth/discord/callback
