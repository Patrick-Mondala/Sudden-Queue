# Copy to .env and fill in. .env is gitignored - never commit real secrets.

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Change if you point at a hosted instance.
DATABASE_URL=postgresql://suddenqueue:suddenqueue_dev@localhost:5432/suddenqueue

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Signs session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Discord OAuth ----------------------------------------------------------
# Create an application at https://discord.com/developers/applications
# Then OAuth2 -> Redirects -> add the callback URL below.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:3000/auth/discord/callback

# --- The game this deployment serves ----------------------------------------
# All optional. Unset means the default, which is a 5v5 shooter.
# Read once at startup, so restart after changing them.
#
# SQ_APP_NAME=Sudden Queue
# SQ_GAME_NAME=Sudden Attack Zero Point
#
# Players a side. The match size is always twice this and is not set separately.
# SQ_TEAM_SIZE=5
#
# Largest group that may queue together. Defaults to a full team; it may not
# exceed one, since a larger party could never be matched.
# SQ_MAX_PARTY_SIZE=5
#
# Largest registered roster, substitutes included.
# SQ_MAX_TEAM_SIZE=10
#
# Queueable regions, as id:name. The short label shown on buttons is derived
# from the id. Ids are stored on tickets, so changing one strands old rows.
# SQ_REGIONS=na:North America,sa:South America,eu:Europe,asia:Asia
#
# Rank names weakest first, and the rating each begins at. The two are
# index-aligned, so they must be the same length, and the floors must increase.
# SQ_TIERS=F-,F,F+,D-,D,D+,C-,C,C+,B-,B,B+,A-,A,A+,G-,G,G+,S-,S,S+
# SQ_TIER_FLOORS=620,675,730,785,840,895,950,1005,1060,1115,1170,1225,1280,1335,1390,1445,1500,1555,1610,1665,1720
#
# Where an unrated player starts, and how many games before a rank is shown.
# SQ_DEFAULT_RATING=1200
# SQ_PLACEMENT_GAMES=5
